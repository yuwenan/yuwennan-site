---
import { withBase } from '@/config/paths';
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import { mdxComponents } from '@/components/mdx';
import Icon from '@/components/ui/Icon.astro';
import NextProject from '@/components/work/NextProject.astro';
import AppScreens from '@/components/work/AppScreens.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { caseStudySchema } from '@/lib/schema';
import { getProjects, type Project } from '@/lib/work';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: { project, next: projects[(index + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const {
  title,
  client,
  summary,
  role,
  services,
  duration,
  team,
  cover,
  coverAlt,
  coverCaption,
  tint,
  url,
  status,
  category,
  appScreens,
} = project.data;
const { Content } = await render(project);
const share = await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'png' });

const meta = [
  { label: '项目', value: client },
  { label: '形态', value: category },
  { label: '阶段', value: status },
  { label: '我的角色', value: role },
  duration && { label: '周期', value: duration },
  team && { label: '团队', value: team },
].filter((item): item is { label: string; value: string } => Boolean(item));
---

<BaseLayout
  title={`${client} · 项目案例`}
  description={summary}
  image={cover}
  imageAlt={coverAlt}
  type="article"
  structuredData={caseStudySchema(project, share.src)}
>
  <article style={`--tint: ${tint}`}>
    <header class="shell pt-12 sm:pt-16">
      <nav aria-label="位置导航" class="rise">
        <ol class="flex items-center gap-2 text-sm text-muted">
          <li>
            <a class="hover:text-ink" href={withBase('/work/')}>
              全部作品
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <span aria-current="page" class="text-ink">
              {client}
            </span>
          </li>
        </ol>
      </nav>
      <h1 class="rise mt-8 case-title text-headline" style="--rise-step: 1">
        {title}
      </h1>
      <p class="rise mt-6 max-w-2xl case-summary text-body" style="--rise-step: 2">
        {summary}
      </p>

      <div class="rise mt-12 grid gap-8 border-t border-line pt-8 lg:grid-cols-[1fr_auto]" style="--rise-step: 3">
        <dl class="grid grid-cols-2 gap-x-8 gap-y-6 sm:grid-cols-3 lg:flex lg:gap-14">
          {meta.map((item) => (
            <div>
              <dt class="text-sm text-muted">{item.label}</dt>
              <dd class="mt-1 font-medium">{item.value}</dd>
            </div>
          ))}
        </dl>
        {url && (
          <a class="btn btn-ghost btn-sm self-start" href={url} rel="noopener">
            体验 {client}
            <Icon name="arrow-up-right" class="icon-nudge-diagonal size-4" />
          </a>
        )}
      </div>

      {services.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="项目能力">
          {services.map((service) => (
            <li class="chip">{service}</li>
          ))}
        </ul>
      )}
    </header>

    {appScreens.length > 0 ? (
      <section class="shell app-showcase" aria-label="App 页面展示">
        <div class="app-showcase-heading">
          <p class="eyebrow">APP EXPERIENCE</p>
          <p>从关键页面，走进用户体验</p>
          <span>点击截图查看大图 · 小屏可左右滑动</span>
        </div>
        <AppScreens screens={appScreens} />
      </section>
    ) : (
      <div class="shell mt-12 sm:mt-16">
        <div
          class:list={['tint-panel overflow-hidden rounded-card p-[4%]', project.id === 'claudewatch' && 'watch-hero']}
        >
          <button
            type="button"
            class="figure-button"
            data-lightbox={cover.src}
            data-image-title={coverAlt}
            aria-label={`放大查看：${coverAlt}`}
          >
            <Image
              src={cover}
              alt={coverAlt}
              widths={[800, 1200, 1600, 2400, 3200]}
              sizes="(min-width: 80rem) 68rem, 90vw"
              quality={90}
              loading="eager"
              fetchpriority="high"
              class="shot w-full"
            />
          </button>
        </div>
        {coverCaption && <p class="figure-hint">{coverCaption}</p>}
      </div>
    )}

    <div class="shell mt-16 sm:mt-24">
      <div class="prose case-prose">
        <Content components={mdxComponents} />
      </div>
    </div>
  </article>

  {next.id !== project.id && <NextProject project={next} />}
</BaseLayout>

<style>
  .case-prose > :global(*) {
    margin-inline: auto;
  }

  .case-prose > :global(*:first-child) {
    margin-top: 0;
  }

  .case-prose > :global(p:first-of-type) {
    color: var(--ink);
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.45rem);
    line-height: 1.55;
  }
</style>
